# Live domain, no trailing slash. Canonical URLs, sitemap.xml, robots.txt and
# structured data are built from it. Required in production.
NEXT_PUBLIC_SITE_URL=https://www.oqwik.in

# Set to true on staging so it is never indexed (Vercel previews are blocked automatically).
NEXT_PUBLIC_NOINDEX=

# Codes from Google Search Console / Bing Webmaster Tools (HTML tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Where trial requests from the form are sent (Slack/Zapier/Google Apps Script webhook). Optional:
# without it, requests are only written to the server log.
LEAD_WEBHOOK_URL=
